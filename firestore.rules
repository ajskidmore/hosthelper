rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserRoles() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles;
    }

    function getCurrentRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.currentRole;
    }

    function hasOwnerRole() {
      return isAuthenticated() && 'owner' in getUserRoles();
    }

    function hasProviderRole() {
      return isAuthenticated() && 'provider' in getUserRoles();
    }

    function isCurrentlyOwner() {
      return isAuthenticated() && getCurrentRole() == 'owner';
    }

    function isCurrentlyProvider() {
      return isAuthenticated() && getCurrentRole() == 'provider';
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // Properties collection
    match /properties/{propertyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && hasOwnerRole();
      allow update: if isAuthenticated() && hasOwnerRole() &&
                       resource.data.ownerId == request.auth.uid;
      allow delete: if isAuthenticated() && hasOwnerRole() &&
                       resource.data.ownerId == request.auth.uid;
    }

    // Bookings collection
    match /bookings/{bookingId} {
      // Users can only read their own bookings
      allow read: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      // Only owners can create bookings and must set ownerId to their own ID
      allow create: if isAuthenticated() && hasOwnerRole() &&
                       request.resource.data.ownerId == request.auth.uid;
      // Only owners can update their own bookings
      allow update: if isAuthenticated() && hasOwnerRole() &&
                       resource.data.ownerId == request.auth.uid;
      // Only owners can delete their own bookings
      allow delete: if isAuthenticated() && hasOwnerRole() &&
                       resource.data.ownerId == request.auth.uid;
    }

    // Tasks collection
    match /tasks/{taskId} {
      // Users can only read tasks they created, are assigned to, or public tasks if they're a provider
      allow read: if isAuthenticated() && (
        resource.data.createdBy == request.auth.uid ||
        resource.data.assignedTo == request.auth.uid ||
        (resource.data.isPublic == true && hasProviderRole())
      );
      allow create: if isAuthenticated() && hasOwnerRole();
      allow update: if isAuthenticated() && (
        // Owner can update their own tasks
        resource.data.createdBy == request.auth.uid ||
        // Provider can update if already assigned
        resource.data.assignedTo == request.auth.uid ||
        // Provider can accept public jobs (assign themselves)
        (hasProviderRole() && resource.data.isPublic == true &&
         request.resource.data.assignedTo == request.auth.uid)
      );
      allow delete: if isAuthenticated() && hasOwnerRole() &&
                       resource.data.createdBy == request.auth.uid;
    }

    // Messages collection
    match /messages/{messageId} {
      allow read: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid
      );
      allow create: if isAuthenticated() &&
                       request.resource.data.senderId == request.auth.uid &&
                       // Verify user is a participant in the conversation
                       (request.resource.data.recipientId != null);
      allow update: if isAuthenticated() &&
                       resource.data.recipientId == request.auth.uid;
      // Allow queries based on conversation participation
      allow list: if isAuthenticated();
    }

    // Conversations collection
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() &&
                     request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() &&
                       request.auth.uid in request.resource.data.participants;
      allow update: if isAuthenticated() &&
                       request.auth.uid in resource.data.participants;
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() &&
                     resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid;
    }
  }
}
